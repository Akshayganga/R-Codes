library(readxl)

library(dplyr)

library(tidyr)

library(ggplot2)

assessment_scores <- read_excel("F:/your file.xls")

column_averages <- colMeans(assessment_scores[, sapply(assessment_scores, is.numeric)], na.rm = TRUE)
print(column_averages)

assessment_scores <- data.frame(
  Module = rep(c(""Uppercase Letters"", ""Lowercase Letters"", ""Letter Sounds"", ""Phonemic Awareness""), each = 3),
  Assessment = rep(c(""Baseline"", ""Midterm"", ""Final""), times = 4),
  Score = c(46.111, 95.388, 96.166,  # Uppercase Letters
            44.666, 90.388, 95.222,  # Lowercase Letters
            6.222, 82.000, 92.555,  # Letter Sounds
            10, 70.666, 84.8333)  # Phonemic Awareness
)

assessment_scores$Assessment <- factor(assessment_scores$Assessment, 
                                       levels = c(""Baseline"", ""Midterm"", ""Final""))
custom_colors <- c(""Baseline"" = ""#E74C3C"",  # Red
                   ""Midterm"" = ""#34495E"",  # Navy Blue
                   ""Final"" = ""#27AE60"")    # Dark Green

gplot(assessment_scores, aes(x = factor(Module, levels = c(""Uppercase Letters"", 
                                                            ""Lowercase Letters"", 
                                                            ""Letter Sounds"", 
                                                            ""Phonemic Awareness"")), 
                              y = Score, fill = Assessment)) + 
  geom_bar(stat = ""identity"", position = position_dodge(width = 0.7)) +  # Group bars side by side
  theme_minimal(base_size = 14) +  # Minimal theme with larger text
  labs(title = ""Manjeri UKG"", x = NULL, y = NULL) +  # Remove axis titles
  scale_fill_manual(values = custom_colors) +  # Custom colors for assessments
  theme(
    plot.title = element_text(hjust = 0.5, face = ""bold""),  # Center the title
    axis.text.x = element_text(angle = 45, hjust = 1),  # Rotate x-axis labels
    panel.grid.major = element_line(color = ""gray90""),  # Add major grid lines
    panel.grid.minor = element_line(color = ""gray95""),  # Add minor grid lines
    panel.background = element_rect(fill = ""white"", colour = ""white""),  # White background
    legend.position = ""bottom"",  # Move legend to bottom
    legend.title = element_blank()  # Remove legend title
  )
